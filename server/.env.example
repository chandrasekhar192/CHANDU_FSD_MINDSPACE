# MongoDB Atlas or local connection string (MONGO_URI is also accepted as an alias)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mindspace?retryWrites=true&w=majority

# Secret key for signing JWT tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend origin URL for CORS configuration (no trailing slash)
CLIENT_URL=http://localhost:5173

# Application environment (development or production)
NODE_ENV=development

# Port for the server (Render sets this automatically to 10000)
PORT=5000
